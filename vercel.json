{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index?__path=/$1" }],
  "crons": [{ "path": "/api/cron", "schedule": "17 3 * * *" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "{panel,src}/**"
    }
  }
}
