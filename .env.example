# ===== Telegram =====
# BotFather'dan olingan token (masalan: 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# ===== AI (bepul kalit) =====
# gemini  -> https://aistudio.google.com/apikey   (tavsiya: bepul, o'zbekchani yaxshi biladi)
# groq    -> https://console.groq.com/keys
# openrouter -> https://openrouter.ai/keys
AI_PROVIDER=gemini
AI_API_KEY=
# Bo'sh qolsa provayderning standart modeli ishlatiladi (gemini: gemini-2.5-flash)
AI_MODEL=

# ===== Panel =====
PORT=3000
# 127.0.0.1 = faqat shu kompyuterdan ochiladi. Serverga (VPS) qo'ysangiz 0.0.0.0 va parol qo'ying.
HOST=127.0.0.1
PANEL_PASSWORD=

# ===== Qo'shimcha =====
# Faqat shu Telegram ID'lar ishlata oladi (vergul bilan). Bo'sh = hamma.
ALLOWED_USER_IDS=
# AI eslab qoladigan oxirgi xabarlar soni
HISTORY_LIMIT=30
